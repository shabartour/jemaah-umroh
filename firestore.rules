rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function profileExists(uid) {
      return exists(profilePath(uid));
    }

    function profile(uid) {
      return get(profilePath(uid)).data;
    }

    function activeUser() {
      return signedIn()
        && profileExists(request.auth.uid)
        && profile(request.auth.uid).aktif == true;
    }

    function roleIs(roles) {
      return profile(request.auth.uid).role in roles;
    }

    function isAdmin() {
      return activeUser() && roleIs(['Admin', 'admin']);
    }

    function isStaff() {
      return activeUser()
        && roleIs(['Admin', 'admin', 'Staff', 'staff']);
    }

    function canReadBusinessData() {
      return activeUser()
        && roleIs([
          'Admin',
          'admin',
          'Staff',
          'staff',
          'Viewer',
          'viewer'
        ]);
    }

    function validPortalDocument(data) {
      return data.keys().hasOnly([
          'schemaVersion',
          'documentType',
          'ownerType',
          'ownerKey',
          'driveFileId',
          'displayName',
          'active',
          'sortOrder',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasAll([
          'schemaVersion',
          'documentType',
          'ownerType',
          'ownerKey',
          'driveFileId',
          'displayName',
          'active',
          'sortOrder',
          'createdAt',
          'updatedAt',
          'updatedBy'
        ])
        && data.schemaVersion == 1
        && data.documentType in [
          'itinerary',
          'registration_proof',
          'umrah_letter',
          'umrah_certificate'
        ]
        && (
          (data.documentType == 'itinerary' && data.ownerType == 'package')
          ||
          (data.documentType in ['registration_proof', 'umrah_letter', 'umrah_certificate']
            && data.ownerType == 'jemaah')
        )
        && data.ownerKey is string
        && data.ownerKey.size() >= 1
        && data.ownerKey.size() <= 180
        && data.driveFileId is string
        && data.driveFileId.size() >= 20
        && data.driveFileId.size() <= 200
        && data.driveFileId.matches('^[A-Za-z0-9_-]+$')
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && data.active is bool
        && data.sortOrder is int
        && data.sortOrder >= 0
        && data.sortOrder <= 9999
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      allow create, update, delete: if false;
    }

    match /jemaah/{jemaahId} {
      allow read: if canReadBusinessData();

      allow create, update: if isStaff();

      allow delete: if isAdmin();
    }

    match /paket/{paketId} {
      allow read: if canReadBusinessData();

      allow create, update: if isStaff();

      allow delete: if isAdmin();
    }

    match /portalAccess/{jemaahId} {
      // Client tidak boleh membaca hash atau salt kode akses.
      allow get, list: if false;

      // Admin dan Staff tetap boleh membuat atau memperbarui kode akses.
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly([
          'version',
          'salt',
          'hash',
          'iterations',
          'active',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'version',
          'salt',
          'hash',
          'iterations',
          'active',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.version == 1
        && request.resource.data.salt is string
        && request.resource.data.salt.size() == 24
        && request.resource.data.hash is string
        && request.resource.data.hash.size() == 64
        && request.resource.data.iterations == 210000
        && request.resource.data.active is bool
        && request.resource.data.updatedBy == request.auth.uid;

      // Hanya Admin yang boleh menghapus kode akses.
      allow delete: if isAdmin();
    }

    match /portalDocuments/{documentId} {
      // Metadata hanya dapat dibaca oleh Admin/Staff aplikasi database.
      // Portal publik tidak membaca koleksi ini; WordPress membacanya server-side.
      allow get, list: if isStaff();

      allow create: if isStaff()
        && validPortalDocument(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isStaff()
        && validPortalDocument(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // Hanya Admin dapat menghapus metadata. File Drive tidak ikut dihapus.
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}