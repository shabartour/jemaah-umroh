rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function profileExists(uid) { return exists(profilePath(uid)); }
    function profile(uid) { return get(profilePath(uid)).data; }
    function activeUser() {
      return signedIn() && profileExists(request.auth.uid) && profile(request.auth.uid).aktif == true;
    }
    function roleIs(roles) { return profile(request.auth.uid).role in roles; }
    function isAdmin() { return activeUser() && roleIs(['Admin', 'admin']); }
    function isStaff() { return activeUser() && roleIs(['Admin', 'admin', 'Staff', 'staff']); }
    function canReadBusinessData() {
      return activeUser() && roleIs(['Admin', 'admin', 'Staff', 'staff', 'Viewer', 'viewer']);
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
    match /jemaah/{jemaahId} {
      allow read: if canReadBusinessData();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /paket/{paketId} {
      allow read: if canReadBusinessData();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }
    match /portalAccess/{jemaahId} {
      allow get: if isStaff();
      allow list: if false;
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['version', 'salt', 'hash', 'iterations', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasAll(['version', 'salt', 'hash', 'iterations', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.version == 1
        && request.resource.data.salt is string
        && request.resource.data.salt.size() == 24
        && request.resource.data.hash is string
        && request.resource.data.hash.size() == 64
        && request.resource.data.iterations == 210000
        && request.resource.data.active is bool
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
