# Copy this file to .env.umroh-app-database for local/manual deployment.
# Set this to the project that owns the Document AI processor.
# Use ocr-identity-app only if the KTP processor is actually in that project.
DOCUMENT_AI_PROJECT_ID=umroh-app-database
DOCUMENT_AI_PROCESSOR_ID=REPLACE_WITH_PROCESSOR_ID
DOCUMENT_AI_LOCATION=asia-southeast1

# The Vertex AI project can be separate from the Document AI project.
VERTEX_PROJECT_ID=umroh-app-database
VERTEX_LOCATION=asia-southeast1
GEMINI_MODEL=gemini-3.5-flash
FUNCTION_REGION=asia-southeast1
